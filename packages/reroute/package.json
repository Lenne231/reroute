{
  "name": "reroute",
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.2",
  "description": "Type-safe React router with typed route params and nested route config",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit test/types/routes.type-test.ts --module ESNext --moduleResolution Bundler --jsx react-jsx --strict --skipLibCheck --types node"
  },
  "keywords": [
    "router",
    "react",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^5.1.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^7.1.7",
    "typescript": "^5.6.3",
    "vitest": "^5.0.1"
  }
}
