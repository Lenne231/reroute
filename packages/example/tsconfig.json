{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "reroute": ["../reroute/src/index.ts"]
    },
    "types": ["vite/client", "@vitejs/plugin-rsc/types"]
  },
  "include": [
    "src",
    "main.tsx",
    "entry.browser.tsx",
    "entry.rsc.tsx",
    "entry.ssr.tsx",
    "reroute.d.ts",
    "vite.config.ts"
  ]
}
