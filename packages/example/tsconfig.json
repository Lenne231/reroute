{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client", "@vitejs/plugin-rsc/types"]
  },
  "include": [
    "src",
    "main.tsx",
    "entry-client.tsx",
    "entry.rsc.tsx",
    "entry.ssr.tsx",
    "reroute.d.ts",
    "vite.config.ts"
  ]
}
